# Keep this value stable after saving Node-RED credentials.
NODE_RED_CREDENTIAL_SECRET=local-development-secret

# Create a bot with @BotFather and paste the token into the Telegram bot
# configuration inside Node-RED. Do not commit real Telegram tokens.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_TOKEN

# Calculator validation settings
CALCULATOR_MAX_INPUT_LENGTH=50
CALCULATOR_MAX_ABS_VALUE=1000000
CALCULATOR_DECIMAL_PLACES=10
